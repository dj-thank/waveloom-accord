{
  "name": "kagariai",
  "version": "1.0.0-rc.4",
  "private": true,
  "type": "module",
  "description": "『篝合』ブラウザFPS Production Candidate — 18ヒーロー、PBR競技マップ、空間音響、戦術HUD、本番サーバー",
  "scripts": {
    "start": "node server/index.js",
    "server": "node server/index.js",
    "headless": "node tools/headless.js",
