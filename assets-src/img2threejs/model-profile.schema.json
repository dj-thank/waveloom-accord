{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kagariai.local/schemas/img2threejs/model-profile.schema.json",
  "title": "Kagariai Img2ThreeJS hero modeling profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["id","references","role","cohort","modelArchetype","proportions","silhouetteAnchors","materialPalette","primitives","rig","animation","reconstructionRisks","qualityAcceptance","rollout","status"],
  "properties": {
    "id": {"type":"string","pattern":"^[a-z0-9-]+$"},
    "references": {"type":"object","additionalProperties":false,"required":["alpha","green"],"properties":{"alpha":{"type":"string","pattern":"^(?!/)(?!.*\\\\)(?!.*\\.\\.)[^\\s]+$"},"green":{"type":"string","pattern":"^(?!/)(?!.*\\\\)(?!.*\\.\\.)[^\\s]+$"}}},
    "role": {"enum":["frontline","damage","support"]},
    "cohort": {"type":"string","minLength":3},
    "modelArchetype": {"type":"string","minLength":5},
    "proportions": {"type":"object","additionalProperties":false,"required":["heightM","bodyRatio","notes"],"properties":{"heightM":{"type":"number","minimum":1.2,"maximum":3.5},"bodyRatio":{"type":"string","minLength":5},"notes":{"type":"string","minLength":12}}},
    "silhouetteAnchors": {"type":"object","additionalProperties":false,"required":["front","side"],"properties":{"front":{"type":"array","minItems":3,"items":{"type":"string","minLength":5}},"side":{"type":"array","minItems":3,"items":{"type":"string","minLength":5}}}},
    "materialPalette": {"type":"array","minItems":3,"items":{"type":"object","additionalProperties":false,"required":["name","hex","finish"],"properties":{"name":{"type":"string","minLength":3},"hex":{"type":"string","pattern":"^#[0-9a-fA-F]{6}$"},"finish":{"type":"string","minLength":4}}}},
    "primitives": {"type":"object","additionalProperties":false,"required":["head","torso","limbs","weapons","accessories"],"properties":{"head":{"type":"array","minItems":1,"items":{"type":"string","minLength":5}},"torso":{"type":"array","minItems":1,"items":{"type":"string","minLength":5}},"limbs":{"type":"array","minItems":2,"items":{"type":"string","minLength":5}},"weapons":{"type":"array","minItems":1,"items":{"type":"string","minLength":5}},"accessories":{"type":"array","minItems":1,"items":{"type":"string","minLength":5}}}},
    "rig": {"type":"object","additionalProperties":false,"required":["pivot","sockets","colliders"],"properties":{"pivot":{"type":"string","minLength":5},"sockets":{"type":"array","minItems":3,"items":{"type":"string","minLength":4}},"colliders":{"type":"array","minItems":2,"items":{"type":"string","minLength":5}}}},
    "animation": {"type":"object","additionalProperties":false,"required":["locomotion","combat","deformationBudget"],"properties":{"locomotion":{"type":"array","minItems":3,"items":{"type":"string","minLength":5}},"combat":{"type":"array","minItems":2,"items":{"type":"string","minLength":5}},"deformationBudget":{"type":"string","minLength":12}}},
    "reconstructionRisks": {"type":"array","minItems":2,"items":{"type":"string","minLength":12}},
    "qualityAcceptance": {"type":"object","additionalProperties":false,"required":["targets","gates"],"properties":{"targets":{"type":"array","minItems":3,"items":{"type":"string","minLength":12}},"gates":{"type":"array","minItems":2,"items":{"type":"string","minLength":8}}}},
    "rollout": {"type":"object","additionalProperties":false,"required":["priority","rationale"],"properties":{"priority":{"type":"integer","minimum":1,"maximum":18},"rationale":{"type":"string","minLength":12}}},
    "status": {"enum":["brief","in-progress","blocked","qa"]}
  }
}


